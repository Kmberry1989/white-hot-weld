---
import type { CtaLink } from "../../types/ui";
import PageContainer from "../layout/PageContainer.astro";
import styles from "./Hero.module.css";

interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  primaryCta: CtaLink;
  secondaryCta?: CtaLink;
  dragonModelSrc?: string;
  roseModelSrc?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  primaryCta,
  secondaryCta,
  dragonModelSrc = "/models/dragon.glb",
  roseModelSrc = "/models/rose.glb"
} = Astro.props;

const sparks = Array.from({ length: 22 }, (_, index) => {
  const left = (index * 17.9) % 100;
  const top = 56 + ((index * 11.7) % 36);
  const delay = (index * 0.43) % 4.8;
  const duration = 2.4 + (index % 6) * 0.42;
  const size = 1.2 + (index % 4) * 0.65;
  const drift = 20 + (index % 5) * 14;
  const rise = 38 + (index % 7) * 14;
  const rotate = -32 + (index % 8) * 8;

  return { left, top, delay, duration, size, drift, rise, rotate };
});
---

<section class={styles.hero} data-hero>
  <div class={styles.backgroundFx} aria-hidden="true">
    <div class={styles.shadowVignette}></div>
    <div class={styles.stageShell}>
      <div class={styles.stageDivider}></div>
      <div class={styles.stageFrame}>
        <div class={styles.modelStage} data-hero-stage>
          <div class={`${styles.modelGroup} ${styles.dragonGroup}`} data-hero-group="dragon">
            <model-viewer
              src={dragonModelSrc}
              class={styles.modelViewer}
              data-hero-model
              data-hero-group="dragon"
              autoplay
              animation-speed="0.42"
              interaction-prompt="none"
              disable-zoom
              disable-pan
              shadow-intensity="1.15"
              exposure="1.15"
            />
          </div>
          <div class={`${styles.modelGroup} ${styles.roseGroup}`} data-hero-group="rose">
            <model-viewer
              src={roseModelSrc}
              class={styles.modelViewer}
              data-hero-model
              data-hero-group="rose"
              autoplay
              animation-speed="0.42"
              interaction-prompt="none"
              disable-zoom
              disable-pan
              shadow-intensity="1.15"
              exposure="1.15"
            />
          </div>
        </div>
      </div>
    </div>
    <div class={styles.sparkField}>
      {
        sparks.map((spark) => (
          <span
            class={styles.spark}
            style={`--spark-left:${spark.left}%; --spark-top:${spark.top}%; --spark-delay:${spark.delay}s; --spark-duration:${spark.duration}s; --spark-size:${spark.size}px; --spark-drift:${spark.drift}px; --spark-rise:${spark.rise}px; --spark-rotate:${spark.rotate}deg;`}
          ></span>
        ))
      }
    </div>
    <div class={styles.flashWash}></div>
  </div>

  <PageContainer size="wide" className={styles.container}>
    <div class={styles.copy} data-reveal>
      {eyebrow && <p class={styles.eyebrow}>{eyebrow}</p>}
      <h1>{title}</h1>
      <p class={styles.subtitle}>{subtitle}</p>
      <div class={styles.actions}>
        <a class={styles.primary} href={primaryCta.href} data-magnetic>{primaryCta.label}</a>
        {secondaryCta && (
          <a class={styles.secondary} href={secondaryCta.href} data-magnetic>
            {secondaryCta.label}
          </a>
        )}
      </div>
    </div>
  </PageContainer>
</section>

<script>
  (() => {
    const clamp = (value: number, min: number, max: number): number => Math.min(max, Math.max(min, value));

    const initHero = () => {
      document.querySelectorAll("[data-hero]").forEach((heroNode) => {
        if (!(heroNode instanceof HTMLElement) || heroNode.dataset.heroBound === "true") {
          return;
        }

        const hero = heroNode;
        const stage = hero.querySelector<HTMLElement>("[data-hero-stage]");
        const models = Array.from(hero.querySelectorAll<HTMLElement>("model-viewer[data-hero-model]"));

        if (!(stage instanceof HTMLElement) || models.length === 0) {
          hero.dataset.heroBound = "true";
          return;
        }

        const state = {
          x: 0,
          y: 0,
          mx: 0,
          my: 0,
          tx: 0,
          ty: 0,
          blur: 2.8,
          zoom: 1,
          radius: 116
        };

        let active = false;
        let rafId = 0;
        let lastOrbitTheta = Number.NaN;

        const updateFromLayout = (): number => {
          const rect = hero.getBoundingClientRect();
          return clamp(Math.max(0, -rect.top) / Math.max(rect.height * 0.9, 1), 0, 1);
        };

        const applyScene = (): boolean => {
          const scrollProgress = updateFromLayout();
          const timeSeconds = performance.now() / 1000;

          state.tx += (state.mx - state.tx) * 0.16;
          state.ty += (state.my - state.ty) * 0.16;
          state.x += (state.tx - state.x) * 0.08;
          state.y += (state.ty - state.y) * 0.08;

          const targetZoom = 1;
          const targetRadius = active ? 116 : 126;
          const targetBlur = (active ? 0.22 : 2.8) + scrollProgress * 6.4;

          state.zoom += (targetZoom - state.zoom) * 0.065;
          state.radius += (targetRadius - state.radius) * 0.065;
          state.blur += (targetBlur - state.blur) * 0.075;

          stage.style.setProperty("--hero-model-scale", state.zoom.toFixed(3));
          stage.style.setProperty("--hero-model-dynamic-blur", `${state.blur.toFixed(2)}px`);
          stage.style.setProperty("--hero-model-obscure-opacity", `${(1 - scrollProgress * 0.5).toFixed(3)}`);

          const thetaBase = -14 + state.x * 19;
          const phiBase = 76 + state.y * -8;
          const phi = clamp(phiBase, 58, 86);
          models.forEach((model) => {
            const group = model.dataset.heroGroup;
            const orbitDrift = group === "rose" ? timeSeconds * 6.2 : 0;
            const thetaOffset = group === "dragon" ? -6 : 7 + orbitDrift;
            const phiOffset = group === "dragon" ? -3.2 : -2.4;
            const radiusOffset = group === "dragon" ? 24 : -2;
            const radius = `${(state.radius + radiusOffset).toFixed(1)}%`;
            const theta = thetaBase + thetaOffset;
            model.setAttribute(
              "camera-orbit",
              `${theta.toFixed(2)}deg ${clamp(phi + phiOffset, 58, 86).toFixed(2)}deg ${radius}`
            );
            if (group === "rose") {
              lastOrbitTheta = theta;
            }
          });

          const settled =
            Math.abs(state.mx - state.tx) < 0.001 &&
            Math.abs(state.my - state.ty) < 0.001 &&
            Math.abs(state.tx - state.x) < 0.001 &&
            Math.abs(state.ty - state.y) < 0.001 &&
            Math.abs(targetZoom - state.zoom) < 0.001 &&
            Math.abs(targetRadius - state.radius) < 0.02 &&
            Math.abs(targetBlur - state.blur) < 0.02 &&
            Math.abs(((thetaBase + 7 + timeSeconds * 6.2) - lastOrbitTheta)) < 0.02;

          return !settled;
        };

        const queueTick = (): void => {
          if (rafId !== 0) {
            return;
          }

          rafId = window.requestAnimationFrame(tick);
        };

        const setTargetFromPointer = (event: PointerEvent): void => {
          const rect = hero.getBoundingClientRect();
          if (rect.width < 1 || rect.height < 1) {
            return;
          }

          const nx = ((event.clientX - rect.left) / rect.width) * 2 - 1;
          const ny = ((event.clientY - rect.top) / rect.height) * 2 - 1;

          state.mx = clamp(nx, -1, 1);
          state.my = clamp(ny, -1, 1);
          active = true;
          queueTick();
        };

        const deactivate = (): void => {
          active = false;
          queueTick();
        };

        const onWindowBlur = (): void => {
          deactivate();
        };

        const onResize = (): void => {
          queueTick();
        };

        const onVisibility = (): void => {
          if (document.hidden) {
            deactivate();
          }
        };

        const onPointerDown = (event: PointerEvent): void => {
          setTargetFromPointer(event);
        };

        const onPointerMove = (event: PointerEvent): void => {
          setTargetFromPointer(event);
        };

        const onPointerUp = (): void => {
          deactivate();
        };

        const onPointerLeave = (): void => {
          deactivate();
        };

        const tick = (): void => {
          rafId = 0;

          if (!document.body.contains(hero)) {
            cleanup();
            return;
          }

          if (applyScene()) {
            queueTick();
          }
        };

        const cleanup = (): void => {
          window.cancelAnimationFrame(rafId);
          hero.removeEventListener("pointerdown", onPointerDown);
          hero.removeEventListener("pointermove", onPointerMove);
          hero.removeEventListener("pointerup", onPointerUp);
          hero.removeEventListener("pointercancel", onPointerUp);
          hero.removeEventListener("pointerleave", onPointerLeave);
          window.removeEventListener("blur", onWindowBlur);
          window.removeEventListener("resize", onResize);
          document.removeEventListener("visibilitychange", onVisibility);
          window.removeEventListener("scroll", queueTick);
          hero.dataset.heroBound = "false";
        };

        hero.addEventListener("pointerdown", onPointerDown, { passive: true });
        hero.addEventListener("pointermove", onPointerMove, { passive: true });
        hero.addEventListener("pointerup", onPointerUp, { passive: true });
        hero.addEventListener("pointercancel", onPointerUp, { passive: true });
        hero.addEventListener("pointerleave", onPointerLeave);
        window.addEventListener("blur", onWindowBlur);
        window.addEventListener("resize", onResize, { passive: true });
        document.addEventListener("visibilitychange", onVisibility);
        window.addEventListener("scroll", queueTick, { passive: true });

        hero.dataset.heroBound = "true";
        applyScene();
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initHero, { once: true });
    } else {
      initHero();
    }

    document.addEventListener("astro:after-swap", initHero);
  })();
</script>
