---
import { ClientRouter } from "astro:transitions";
import ForgeShaderBackground from "../effects/ForgeShaderBackground.astro";
import type { EffectPreset } from "../../types/effects";
import type { NavItem } from "../../types/ui";
import { absoluteUrl, getSocialLinks, siteConfig } from "../../lib/site";
import "../../styles/global.css";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

interface Props {
  title?: string;
  description?: string;
  seoTitle?: string;
  seoDescription?: string;
  effectPreset?: EffectPreset;
  disableEffects?: boolean;
}

const {
  title,
  description,
  seoTitle,
  seoDescription,
  effectPreset = "inner",
  disableEffects = false
} = Astro.props as Props;

const navItems: NavItem[] = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/gallery/lowres", label: "Gallery" },
  { href: "/gallery", label: "Shop" },
  { href: "/contact", label: "Contact" }
];

const socialLinks = getSocialLinks();

const pageTitle = seoTitle ?? (title ? `${title} | ${siteConfig.name}` : siteConfig.title);
const pageDescription = seoDescription ?? description ?? siteConfig.description;
const canonicalUrl = absoluteUrl(Astro.url.pathname);
const socialImageUrl = absoluteUrl(siteConfig.defaultOgImage);
const canonicalHref = canonicalUrl ?? Astro.url.pathname;
const socialImage = socialImageUrl ?? siteConfig.defaultOgImage;
const showMotorcycleRide = effectPreset === "home";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalHref} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <title>{pageTitle}</title>
  </head>
  <body data-effect-preset={effectPreset} data-effects-disabled={disableEffects ? "true" : "false"}>
    <ForgeShaderBackground preset={effectPreset} disable={disableEffects} />

    <div class="site-shell">
      <Header navItems={navItems} currentPath={Astro.url.pathname} />
      <main>
        <slot />
      </main>
      <Footer
        tagline="Married Metal Art. Began with a spark. Built to endure."
        navItems={navItems}
        socialLinks={socialLinks}
      />
    </div>

    {
      showMotorcycleRide && (
        <div class="motorcycle-runner" data-motorcycle-runner aria-hidden="true">
          <canvas class="motorcycle-smoke-canvas" data-motorcycle-smoke></canvas>
          <div class="motorcycle-track" data-motorcycle-track>
            <model-viewer
              class="motorcycle-model"
              data-motorcycle-model
              src="/models/motorcycle.glb"
              interaction-prompt="none"
              disable-zoom
              disable-pan
              shadow-intensity="1.05"
              exposure="1.08"
              camera-orbit="-86deg 78deg 98%"
              field-of-view="29deg"
            />
          </div>
        </div>
      )
    }

    <script>
      import { initForgeShader } from "../../scripts/effects/forgeShader";
      import { initHoverFx } from "../../scripts/effects/hoverFx";
      import { initPageMotion } from "../../scripts/effects/pageMotion";
      import { initArcFlash } from "../../scripts/effects/arcFlash";
      import { initMotorcycleRide } from "../../scripts/effects/motorcycleRide";

      const bootstrapEffects = () => {
        const layer = document.querySelector("[data-forge-shader]");
        const body = document.body;

        if (layer instanceof HTMLElement && body) {
          const preset = (body.dataset.effectPreset ?? "inner");
          const disabled = body.dataset.effectsDisabled === "true";
          initForgeShader(layer, preset, disabled);
          initArcFlash(layer, preset, disabled);
          initMotorcycleRide(layer, preset, disabled || preset !== "home");
        }

        initHoverFx();
        initPageMotion();
      };

      const win = window as Window & { __whwEffectsBound?: boolean };
      if (!win.__whwEffectsBound) {
        document.addEventListener("astro:page-load", bootstrapEffects);
        win.__whwEffectsBound = true;
      }

      bootstrapEffects();
    </script>
  </body>
</html>
