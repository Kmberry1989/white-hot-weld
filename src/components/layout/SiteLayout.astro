---
import { ClientRouter } from "astro:transitions";
import ForgeShaderBackground from "../effects/ForgeShaderBackground.astro";
import type { EffectPreset } from "../../types/effects";
import type { NavItem, SocialLink } from "../../types/ui";
import "../../styles/global.css";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

interface Props {
  title?: string;
  description?: string;
  seoTitle?: string;
  seoDescription?: string;
  effectPreset?: EffectPreset;
  disableEffects?: boolean;
}

const {
  title,
  description,
  seoTitle,
  seoDescription,
  effectPreset = "inner",
  disableEffects = false
} = Astro.props as Props;

const navItems: NavItem[] = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/gallery", label: "Shop" },
  { href: "/contact", label: "Contact" }
];

const socialLinks: SocialLink[] = [
  { href: "#", label: "Instagram" },
  { href: "#", label: "Email" }
];

const pageTitle = seoTitle ?? (title ? `${title} | White Hot Weld` : "White Hot Weld");
const pageDescription =
  seoDescription ?? description ?? "Married metal art shaped with warmth, intention, and precision.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <title>{pageTitle}</title>
  </head>
  <body data-effect-preset={effectPreset} data-effects-disabled={disableEffects ? "true" : "false"}>
    <ForgeShaderBackground preset={effectPreset} disable={disableEffects} />

    <div class="site-shell">
      <Header navItems={navItems} currentPath={Astro.url.pathname} />
      <main>
        <slot />
      </main>
      <Footer
        tagline="Married Metal Art. Began with a spark. Built to endure."
        navItems={navItems}
        socialLinks={socialLinks}
      />
    </div>

    <script>
      import { initForgeShader } from "../../scripts/effects/forgeShader";
      import { initHoverFx } from "../../scripts/effects/hoverFx";
      import { initPageMotion } from "../../scripts/effects/pageMotion";
      import { initArcFlash } from "../../scripts/effects/arcFlash";

      const bootstrapEffects = () => {
        const layer = document.querySelector("[data-forge-shader]");
        const body = document.body;

        if (layer instanceof HTMLElement && body) {
          const preset = (body.dataset.effectPreset ?? "inner");
          const disabled = body.dataset.effectsDisabled === "true";
          initForgeShader(layer, preset, disabled);
          initArcFlash(layer, preset, disabled);
        }

        initHoverFx();
        initPageMotion();
      };

      const win = window as Window & { __whwEffectsBound?: boolean };
      if (!win.__whwEffectsBound) {
        document.addEventListener("astro:page-load", bootstrapEffects);
        win.__whwEffectsBound = true;
      }

      bootstrapEffects();
    </script>
  </body>
</html>
