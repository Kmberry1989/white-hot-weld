---
import type { NavItem, SocialLink } from "../../types/ui";
import SocialIcons from "../ui/SocialIcons.astro";
import PageContainer from "./PageContainer.astro";
import styles from "./Footer.module.css";

interface Props {
  tagline: string;
  navItems: NavItem[];
  socialLinks: SocialLink[];
}

const { tagline, navItems, socialLinks } = Astro.props;
---

<footer class={styles.footer}>
  <PageContainer size="wide" className={styles.container}>
    <div class={styles.brandBlock}>
      <img
        src="/images/branding/penrod.png"
        alt="Penrod signature mark"
        class={styles.signature}
        loading="lazy"
        decoding="async"
      />
      <p class={styles.tagline}>{tagline}</p>
    </div>

    <ul class={styles.nav}>
      {
        navItems.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>

    {
      socialLinks.length > 0 && (
        <div class={styles.socialWrap}>
          <SocialIcons links={socialLinks} size="compact" showLabels />
        </div>
      )
    }
  </PageContainer>
</footer>
