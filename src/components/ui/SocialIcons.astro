---
import type { SocialLink } from "../../types/ui";

interface Props {
  links: SocialLink[];
  showLabels?: boolean;
  size?: "compact" | "default";
}

const { links, showLabels = false, size = "default" } = Astro.props;

function getKind(link: SocialLink): "facebook" | "instagram" | "phone" | "email" | "generic" {
  const haystack = `${link.label} ${link.href}`.toLowerCase();
  if (haystack.includes("facebook")) return "facebook";
  if (haystack.includes("instagram")) return "instagram";
  if (haystack.includes("tel:") || haystack.includes("call") || haystack.includes("phone")) return "phone";
  if (haystack.includes("mailto:") || haystack.includes("email")) return "email";
  return "generic";
}
---

{
  links.length > 0 && (
    <ul class={`social-icons social-icons-${size}`} aria-label="Social links">
      {links.map((link) => {
        const kind = getKind(link);
        return (
          <li>
            <a
              href={link.href}
              class="weld-icon"
              data-kind={kind}
              aria-label={link.label}
              target={link.href.startsWith("mailto:") || link.href.startsWith("tel:") ? undefined : "_blank"}
              rel={link.href.startsWith("mailto:") || link.href.startsWith("tel:") ? undefined : "noopener noreferrer"}
            >
              <span class="spark"></span>
              <span class="spark"></span>
              <span class="spark"></span>
              <span class="spark"></span>
              <span class="spark"></span>
              <span class="spark"></span>
              <span class="spark"></span>
              <span class="spark"></span>
              <span class="spark"></span>
              <span class="flare-orbit" aria-hidden="true">
                <span class="flare"></span>
              </span>
              <svg class="icon-svg" viewBox="0 0 100 100" role="presentation" aria-hidden="true">
                {kind === "facebook" ? (
                  <>
                    <path class="heat-haze" d="M58 18h16V2H58C42 2 32 12 32 29v13H18v17h14v39h18V59h18l3-17H50V30c0-7 3-12 8-12z" />
                    <path class="base-stroke" d="M58 18h16V2H58C42 2 32 12 32 29v13H18v17h14v39h18V59h18l3-17H50V30c0-7 3-12 8-12z" />
                    <path class="weld-trace" d="M58 18h16V2H58C42 2 32 12 32 29v13H18v17h14v39h18V59h18l3-17H50V30c0-7 3-12 8-12z" />
                    <path class="blue-core" d="M58 18h16V2H58C42 2 32 12 32 29v13H18v17h14v39h18V59h18l3-17H50V30c0-7 3-12 8-12z" />
                  </>
                ) : kind === "instagram" ? (
                  <>
                    <path class="heat-haze" d="M31 12h38c11 0 19 8 19 19v38c0 11-8 19-19 19H31c-11 0-19-8-19-19V31c0-11 8-19 19-19z M50 34a16 16 0 1 0 0 32a16 16 0 0 0 0-32z M72 27h1" />
                    <path class="base-stroke" d="M31 12h38c11 0 19 8 19 19v38c0 11-8 19-19 19H31c-11 0-19-8-19-19V31c0-11 8-19 19-19z M50 34a16 16 0 1 0 0 32a16 16 0 0 0 0-32z M72 27h1" />
                    <path class="weld-trace" d="M31 12h38c11 0 19 8 19 19v38c0 11-8 19-19 19H31c-11 0-19-8-19-19V31c0-11 8-19 19-19z M50 34a16 16 0 1 0 0 32a16 16 0 0 0 0-32z M72 27h1" />
                    <path class="blue-core" d="M31 12h38c11 0 19 8 19 19v38c0 11-8 19-19 19H31c-11 0-19-8-19-19V31c0-11 8-19 19-19z M50 34a16 16 0 1 0 0 32a16 16 0 0 0 0-32z M72 27h1" />
                  </>
                ) : kind === "phone" ? (
                  <>
                    <path class="heat-haze" d="M20 25h60c6 0 10 4 10 10v30c0 6-4 10-10 10H52L30 90V75H20c-6 0-10-4-10-10V35c0-6 4-10 10-10z M34 50h1 M50 50h1 M66 50h1" />
                    <path class="base-stroke" d="M20 25h60c6 0 10 4 10 10v30c0 6-4 10-10 10H52L30 90V75H20c-6 0-10-4-10-10V35c0-6 4-10 10-10z M34 50h1 M50 50h1 M66 50h1" />
                    <path class="weld-trace" d="M20 25h60c6 0 10 4 10 10v30c0 6-4 10-10 10H52L30 90V75H20c-6 0-10-4-10-10V35c0-6 4-10 10-10z M34 50h1 M50 50h1 M66 50h1" />
                    <path class="blue-core" d="M20 25h60c6 0 10 4 10 10v30c0 6-4 10-10 10H52L30 90V75H20c-6 0-10-4-10-10V35c0-6 4-10 10-10z M34 50h1 M50 50h1 M66 50h1" />
                  </>
                ) : kind === "email" ? (
                  <>
                    <path class="heat-haze" d="M18 26h64c7 0 12 5 12 12v24c0 7-5 12-12 12H18c-7 0-12-5-12-12V38c0-7 5-12 12-12z M10 34l40 28l40-28" />
                    <path class="base-stroke" d="M18 26h64c7 0 12 5 12 12v24c0 7-5 12-12 12H18c-7 0-12-5-12-12V38c0-7 5-12 12-12z M10 34l40 28l40-28" />
                    <path class="weld-trace" d="M18 26h64c7 0 12 5 12 12v24c0 7-5 12-12 12H18c-7 0-12-5-12-12V38c0-7 5-12 12-12z M10 34l40 28l40-28" />
                    <path class="blue-core" d="M18 26h64c7 0 12 5 12 12v24c0 7-5 12-12 12H18c-7 0-12-5-12-12V38c0-7 5-12 12-12z M10 34l40 28l40-28" />
                  </>
                ) : (
                  <>
                    <circle class="heat-haze" cx="50" cy="50" r="28"></circle>
                    <circle class="base-stroke" cx="50" cy="50" r="28"></circle>
                    <circle class="weld-trace" cx="50" cy="50" r="28"></circle>
                    <circle class="blue-core" cx="50" cy="50" r="28"></circle>
                  </>
                )}
              </svg>
              {showLabels ? <span class="icon-label">{link.label}</span> : <span class="sr-only">{link.label}</span>}
            </a>
          </li>
        );
      })}
    </ul>
  )
}

<style>
  :root {
    --social-metal: #d7e3ea;
    --social-hot-white: #ffffff;
    --social-weld-blue: #baf6ff;
    --social-spark: #ffba52;
    --social-ember: #ff6b00;
  }

  .social-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    justify-content: center;
  }

  .social-icons-compact {
    gap: 0.9rem;
  }

  .weld-icon {
    position: relative;
    width: 8.25rem;
    min-height: 8.25rem;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.6rem;
    isolation: isolate;
    border-radius: 1.75rem;
    color: var(--social-metal);
    text-decoration: none;
    background:
      radial-gradient(circle at 50% 42%, rgba(255, 255, 255, 0.09), transparent 35%),
      linear-gradient(145deg, rgba(10, 15, 20, 0.96), rgba(5, 7, 9, 0.98));
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      0 20px 34px rgba(0, 0, 0, 0.34),
      0 0 26px rgba(255, 107, 0, 0.08);
    overflow: clip;
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      color 220ms ease;
  }

  .social-icons-compact .weld-icon {
    width: 5.5rem;
    min-height: 5.5rem;
    border-radius: 1.35rem;
    gap: 0.35rem;
  }

  .weld-icon::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent 34%),
      radial-gradient(circle at 50% 100%, rgba(255, 107, 0, 0.16), transparent 42%);
    pointer-events: none;
  }

  .weld-icon::after {
    content: "";
    position: absolute;
    inset: 22%;
    border-radius: 999px;
    background:
      conic-gradient(
        from 0deg,
        transparent,
        rgba(255, 255, 255, 0.28),
        transparent,
        rgba(255, 186, 82, 0.26),
        transparent,
        rgba(186, 246, 255, 0.26),
        transparent
      );
    filter: blur(0.65rem);
    opacity: 0.82;
    animation: weld-ring-spin 9s linear infinite;
    pointer-events: none;
  }

  .icon-svg,
  .flare-orbit,
  .spark,
  .icon-label {
    position: relative;
    z-index: 1;
  }

  .icon-svg {
    width: 4.9rem;
    height: 4.9rem;
    overflow: visible;
  }

  .social-icons-compact .icon-svg {
    width: 3.6rem;
    height: 3.6rem;
  }

  .base-stroke {
    fill: none;
    stroke: rgba(215, 227, 234, 0.92);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter:
      drop-shadow(0 0 3px rgba(255, 255, 255, 0.7))
      drop-shadow(0 0 10px rgba(186, 246, 255, 0.35));
  }

  .weld-trace {
    fill: none;
    stroke: white;
    stroke-width: 8.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 22 330;
    stroke-dashoffset: 0;
    opacity: 0.98;
    filter:
      drop-shadow(0 0 2px white)
      drop-shadow(0 0 7px white)
      drop-shadow(0 0 16px var(--social-weld-blue))
      drop-shadow(0 0 28px var(--social-spark));
    animation: weldTravel 2.6s linear infinite;
  }

  .blue-core {
    fill: none;
    stroke: var(--social-weld-blue);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 10 342;
    stroke-dashoffset: 0;
    opacity: 0.95;
    filter:
      drop-shadow(0 0 5px var(--social-weld-blue))
      drop-shadow(0 0 15px white);
    animation: weldTravel 2.6s linear infinite;
  }

  .heat-haze {
    fill: none;
    stroke: rgba(255, 255, 255, 0.22);
    stroke-width: 13;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 34 320;
    stroke-dashoffset: 0;
    opacity: 0.55;
    filter: blur(5px);
    animation: weldTravel 2.6s linear infinite;
  }

  .flare-orbit {
    position: absolute;
    inset: 0;
    pointer-events: none;
    animation: flarePath 2.6s linear infinite;
  }

  .flare {
    position: absolute;
    left: 50%;
    top: 20%;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 999px;
    background: white;
    transform: translate(-50%, -50%);
    box-shadow:
      0 0 5px white,
      0 0 12px white,
      0 0 24px var(--social-weld-blue),
      0 0 42px var(--social-spark),
      0 0 64px var(--social-ember);
    animation: flareFlicker 0.34s steps(2, end) infinite;
  }

  .spark {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 3px;
    height: 22px;
    border-radius: 999px;
    background: linear-gradient(to top, transparent, white 18%, var(--social-spark) 62%, transparent);
    transform-origin: center bottom;
    opacity: 0;
    animation: sparkFly 1.15s ease-out infinite;
  }

  .spark:nth-of-type(1) { --angle: 8deg; --dist: 66px; animation-delay: 0s; }
  .spark:nth-of-type(2) { --angle: 34deg; --dist: 78px; animation-delay: .1s; }
  .spark:nth-of-type(3) { --angle: 72deg; --dist: 58px; animation-delay: .22s; }
  .spark:nth-of-type(4) { --angle: 118deg; --dist: 72px; animation-delay: .04s; }
  .spark:nth-of-type(5) { --angle: 164deg; --dist: 68px; animation-delay: .3s; }
  .spark:nth-of-type(6) { --angle: 208deg; --dist: 80px; animation-delay: .15s; }
  .spark:nth-of-type(7) { --angle: 252deg; --dist: 62px; animation-delay: .38s; }
  .spark:nth-of-type(8) { --angle: 306deg; --dist: 76px; animation-delay: .2s; }
  .spark:nth-of-type(9) { --angle: 346deg; --dist: 60px; animation-delay: .34s; }

  .weld-icon:hover .weld-trace,
  .weld-icon:hover .blue-core,
  .weld-icon:hover .heat-haze,
  .weld-icon:hover .flare-orbit {
    animation-duration: 1.25s;
  }

  .weld-icon:hover .spark {
    animation-duration: 0.65s;
  }

  .icon-label {
    font-size: 0.72rem;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(215, 227, 234, 0.84);
  }

  .social-icons-compact .icon-label {
    font-size: 0.58rem;
  }

  .weld-icon:hover {
    transform: translateY(-3px) scale(1.02);
    color: var(--social-hot-white);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 24px 38px rgba(0, 0, 0, 0.42),
      0 0 34px rgba(255, 107, 0, 0.16);
  }

  .weld-icon:hover::after {
    opacity: 1;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes weld-ring-spin {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }

  @keyframes weldTravel {
    to {
      stroke-dashoffset: -352;
    }
  }

  @keyframes flareFlicker {
    0% {
      opacity: 0.85;
      transform: translate(-50%, -50%) scale(0.85);
    }

    100% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.35);
    }
  }

  @keyframes flarePath {
    0% {
      transform: translate(0px, -26px) rotate(0deg);
    }

    20% {
      transform: translate(28px, -8px) rotate(72deg);
    }

    40% {
      transform: translate(22px, 28px) rotate(144deg);
    }

    60% {
      transform: translate(-20px, 30px) rotate(216deg);
    }

    80% {
      transform: translate(-30px, -5px) rotate(288deg);
    }

    100% {
      transform: translate(0px, -26px) rotate(360deg);
    }
  }

  @keyframes sparkFly {
    0% {
      opacity: 0;
      transform: rotate(var(--angle)) translateY(0) scaleY(0.2);
    }

    12% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: rotate(var(--angle)) translateY(calc(var(--dist) * -1)) scaleY(0.06);
    }
  }
</style>
