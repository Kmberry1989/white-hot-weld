---
import type { SocialLink } from "../../types/ui";

interface Props {
  links: SocialLink[];
  showLabels?: boolean;
  size?: "compact" | "default";
}

const { links, showLabels = false, size = "default" } = Astro.props;

function getKind(link: SocialLink): "instagram" | "email" | "generic" {
  const haystack = `${link.label} ${link.href}`.toLowerCase();
  if (haystack.includes("instagram")) return "instagram";
  if (haystack.includes("mailto:") || haystack.includes("email")) return "email";
  return "generic";
}
---

{
  links.length > 0 && (
    <ul class={`social-icons social-icons-${size}`} aria-label="Social links">
      {links.map((link) => {
        const kind = getKind(link);
        return (
          <li>
            <a
              href={link.href}
              class="weld-icon"
              data-kind={kind}
              aria-label={link.label}
              target={link.href.startsWith("mailto:") ? undefined : "_blank"}
              rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
            >
              <span class="weld-ring" aria-hidden="true"></span>
              <span class="weld-core" aria-hidden="true"></span>
              <span class="icon-glyph" aria-hidden="true">
                {kind === "instagram" ? (
                  <svg viewBox="0 0 24 24" role="presentation">
                    <rect x="4.5" y="4.5" width="15" height="15" rx="4.4"></rect>
                    <circle cx="12" cy="12" r="3.5"></circle>
                    <circle cx="17.2" cy="6.9" r="0.9" class="filled"></circle>
                  </svg>
                ) : kind === "email" ? (
                  <svg viewBox="0 0 24 24" role="presentation">
                    <rect x="3.5" y="6" width="17" height="12" rx="2.2"></rect>
                    <path d="M4.8 7.4 12 13l7.2-5.6"></path>
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" role="presentation">
                    <circle cx="12" cy="12" r="7.2"></circle>
                    <path d="M12 7.2v9.6M7.2 12h9.6"></path>
                  </svg>
                )}
              </span>
              {showLabels ? <span class="icon-label">{link.label}</span> : <span class="sr-only">{link.label}</span>}
            </a>
          </li>
        );
      })}
    </ul>
  )
}

<style>
  :root {
    --social-metal: #d7e3ea;
    --social-hot-white: #ffffff;
    --social-weld-blue: #baf6ff;
    --social-spark: #ffba52;
    --social-ember: #ff6b00;
  }

  .social-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    justify-content: center;
  }

  .social-icons-compact {
    gap: 0.9rem;
  }

  .weld-icon {
    position: relative;
    width: 8.25rem;
    min-height: 8.25rem;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.6rem;
    isolation: isolate;
    border-radius: 1.75rem;
    color: var(--social-metal);
    text-decoration: none;
    background:
      radial-gradient(circle at 50% 42%, rgba(255, 255, 255, 0.09), transparent 35%),
      linear-gradient(145deg, rgba(10, 15, 20, 0.96), rgba(5, 7, 9, 0.98));
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      0 20px 34px rgba(0, 0, 0, 0.34),
      0 0 26px rgba(255, 107, 0, 0.08);
    overflow: clip;
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      color 220ms ease;
  }

  .social-icons-compact .weld-icon {
    width: 5.5rem;
    min-height: 5.5rem;
    border-radius: 1.35rem;
    gap: 0.35rem;
  }

  .weld-icon::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid rgba(255, 255, 255, 0.07);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent 34%),
      radial-gradient(circle at 50% 100%, rgba(255, 107, 0, 0.16), transparent 42%);
    pointer-events: none;
  }

  .weld-icon::after {
    content: "";
    position: absolute;
    inset: 22%;
    border-radius: 999px;
    background:
      conic-gradient(
        from 0deg,
        transparent,
        rgba(255, 255, 255, 0.28),
        transparent,
        rgba(255, 186, 82, 0.26),
        transparent,
        rgba(186, 246, 255, 0.26),
        transparent
      );
    filter: blur(0.65rem);
    opacity: 0.82;
    animation: weld-ring-spin 9s linear infinite;
    pointer-events: none;
  }

  .weld-ring,
  .weld-core,
  .icon-glyph,
  .icon-label {
    position: relative;
    z-index: 1;
  }

  .weld-ring {
    position: absolute;
    inset: 18%;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 0 0 1px rgba(186, 246, 255, 0.06),
      0 0 18px rgba(255, 107, 0, 0.18);
  }

  .weld-core {
    position: absolute;
    inset: 29%;
    border-radius: 999px;
    background:
      radial-gradient(circle at 50% 46%, rgba(255, 255, 255, 0.16), transparent 44%),
      radial-gradient(circle at 50% 58%, rgba(255, 107, 0, 0.18), transparent 54%);
    box-shadow:
      inset 0 0 16px rgba(255, 255, 255, 0.04),
      0 0 22px rgba(255, 186, 82, 0.08);
  }

  .icon-glyph {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    color: var(--social-hot-white);
    filter:
      drop-shadow(0 0 8px rgba(186, 246, 255, 0.28))
      drop-shadow(0 0 14px rgba(255, 107, 0, 0.22));
  }

  .social-icons-compact .icon-glyph {
    width: 1.8rem;
    height: 1.8rem;
  }

  .icon-glyph svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-glyph .filled {
    fill: currentColor;
    stroke: none;
  }

  .icon-label {
    font-size: 0.72rem;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(215, 227, 234, 0.84);
  }

  .social-icons-compact .icon-label {
    font-size: 0.58rem;
  }

  .weld-icon:hover {
    transform: translateY(-3px) scale(1.02);
    color: var(--social-hot-white);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 24px 38px rgba(0, 0, 0, 0.42),
      0 0 34px rgba(255, 107, 0, 0.16);
  }

  .weld-icon:hover::after {
    opacity: 1;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes weld-ring-spin {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }
</style>
