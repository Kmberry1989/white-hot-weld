---
// A reusable component to handle either Stripe or Snipcart checkouts.
// This keeps your page markdown/components clean.

interface Props {
  mode: "stripe" | "snipcart";

  // Shared props
  name: string;
  price: number | string;

  // Stripe specific props
  stripeLink?: string; // e.g., https://buy.stripe.com/test_12345
  label?: string;
  className?: string;

  // Snipcart specific props
  id?: string;
  url?: string;
  image?: string;
  description?: string;
}

const {
  mode,
  name,
  price,
  stripeLink,
  label,
  className,
  id,
  url,
  image,
  description
} = Astro.props;

const buttonLabel = label ?? `Buy ${name} - ${price}`;
const classes = ["buy-button", mode === "stripe" ? "stripe-button" : "snipcart-button", className]
  .filter(Boolean)
  .join(" ");
---

{mode === "stripe" ? (
  <a href={stripeLink} class={classes} target="_blank" rel="noopener noreferrer">
    {buttonLabel}
  </a>
) : (
  <button
    class={`${classes} snipcart-add-item`}
    data-item-id={id}
    data-item-price={price}
    data-item-url={url}
    data-item-description={description}
    data-item-image={image}
    data-item-name={name}
  >
    {buttonLabel}
  </button>
)}

<style>
  .buy-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.72rem 1rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-decoration: none;
    background: var(--color-accent);
    color: #0f1113;
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
    font-family: inherit;
  }

  .buy-button:hover {
    background: var(--color-accent-soft);
  }
</style>
