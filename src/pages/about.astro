---
import SiteLayout from "../components/layout/SiteLayout.astro";
import Section from "../components/ui/Section.astro";
import { getPageContent } from "../lib/content";
import { getMediaByCategory, getMediaByUse } from "../lib/media";

const about = await getPageContent("about");
const { Content } = await about.render();

const peopleLead = (await getMediaByUse("about-people-feature"))[0] ?? (await getMediaByCategory("people"))[0];
---

<SiteLayout
  title={about.data.title}
  description={about.data.description}
  seoTitle={about.data.seoTitle}
  seoDescription={about.data.seoDescription}
  effectPreset="inner"
>
  <Section
    id="about"
    kicker={about.data.eyebrow}
    title={about.data.title}
    lede={about.data.description}
    tone="muted"
  >
    {
      peopleLead && (
        <figure class="people-figure surface" data-reveal>
          <img
            src={peopleLead.destPath}
            alt="Sheryl and John in the workshop"
            width={peopleLead.width}
            height={peopleLead.height}
            loading="eager"
          />
        </figure>
      )
    }

    <div class="prose" data-reveal>
      <Content />
    </div>
  </Section>
</SiteLayout>

<style>
  .people-figure {
    margin: 0;
    max-width: 36rem;
    overflow: clip;
  }

  .people-figure img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .prose {
    display: grid;
    gap: var(--space-4);
    max-width: 70ch;
    color: var(--color-text-muted);
  }

  .prose :global(h2) {
    margin-top: var(--space-4);
    font-size: clamp(1.4rem, 4vw, 2rem);
    color: var(--color-text);
  }

  .prose :global(ul) {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding-left: 1.1rem;
  }
</style>
