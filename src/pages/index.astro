---
import SiteLayout from "../components/layout/SiteLayout.astro";
import Hero from "../components/home/Hero.astro";
import FeaturedWork from "../components/home/FeaturedWork.astro";
import CallToAction from "../components/home/CallToAction.astro";
import Section from "../components/ui/Section.astro";
import { getPageContent } from "../lib/content";

const page = await getPageContent("home");
---

<SiteLayout
  title={page.data.title}
  description={page.data.description}
  seoTitle={page.data.seoTitle}
  seoDescription={page.data.seoDescription}
>
  <!-- 1. The Striking New Hero -->
  <Hero />

  <!-- 2. The 3D Showroom Teaser to drive engagement -->
  <Section id="showroom-teaser" kicker="Interactive" title="Virtual Exhibition" lede="Experience the depth, scale, and texture of the metalwork from anywhere.">
    <div class="teaser-box" data-reveal>
      <div class="teaser-content">
        <h3>Explore the 3D Showroom</h3>
        <p>Go beyond flat images. Rotate, zoom, and inspect pieces like the Dragon Catcher and Eternal Rose in a fully interactive 3D environment.</p>
        <a href="/showroom" class="btn-primary mt-3">Enter Showroom</a>
      </div>
      <div class="teaser-visual">
          <img src="/images/library/store/dragon catcher/dragon_catcher_1.jpg" alt="Dragon Catcher Detail" loading="lazy" class="teaser-img" />
          <div class="badge">3D Available</div>
      </div>
    </div>
  </Section>

  <!-- 3. Existing Featured Work Carousel/Grid -->
  <FeaturedWork />

  <!-- Removed Affiliations Section -->

  <CallToAction />
</SiteLayout>

<style>
  /* Showroom Teaser Styles */
  .teaser-box {
    display: grid;
    gap: var(--space-4);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-top: var(--space-4);
  }

  .teaser-content h3 {
    margin-bottom: var(--space-2);
    font-size: 1.5rem;
  }

  .teaser-content p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
    max-width: 50ch;
  }

  .mt-3 {
    margin-top: var(--space-3);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.72rem 1.25rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    background: var(--color-accent);
    color: #0f1113;
    transition: transform 0.2s ease;
  }
  
  .btn-primary:hover {
    transform: translateY(-2px);
  }

  .teaser-visual {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    aspect-ratio: 16/9;
  }

  .teaser-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .teaser-box:hover .teaser-img {
    opacity: 1;
  }

  .badge {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    background: rgba(0,0,0,0.8);
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    padding: 0.25rem 0.75rem;
    border-radius: 99px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    backdrop-filter: blur(4px);
  }

  @media (min-width: 48rem) {
    .teaser-box {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      padding: var(--space-5);
    }
  }
</style>