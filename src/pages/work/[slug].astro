---
import { Image } from "astro:assets";
import SiteLayout from "../../components/layout/SiteLayout.astro";
import PageContainer from "../../components/layout/PageContainer.astro";
import { getAllWork } from "../../lib/content";
import type { WorkItem } from "../../types/content";

export async function getStaticPaths() {
  const work = await getAllWork();

  return work.map((item) => ({
    params: { slug: item.slug },
    props: { work: item }
  }));
}

const { work } = Astro.props as { work: WorkItem };
const { Content } = await work.entry.render();

const medium = work.medium ?? work.materials;
---

<SiteLayout title={work.title} description={work.excerpt} effectPreset="work">
  <PageContainer size="wide" className="work-page">
    <a class="back-link" href="/gallery" data-reveal>← Back to shop</a>

    <div class="hero-media surface" data-reveal>
      <Image
        src={work.coverImage}
        alt={`${work.title} main view`}
        loading="eager"
        fetchpriority="high"
        width={1600}
        height={1000}
        class="cover"
      />
    </div>

    <header class="header" data-reveal>
      <h1>{work.title}</h1>
      {work.price && <p class="price">{work.price}</p>}
      <p class="excerpt">{work.excerpt}</p>
    </header>

    <section class="detail-block" data-reveal>
      <h2>Materials</h2>
      <p>Medium: {medium}</p>
    </section>

    <section class="detail-block" data-reveal>
      <h2>Dimensions</h2>
      <ul>
        {work.widthInches && <li>Width: {work.widthInches} inches</li>}
        {work.heightInches && <li>Height: {work.heightInches} inches</li>}
        {work.depthInches && <li>Depth: {work.depthInches} inches</li>}
      </ul>
    </section>

    <section class="detail-block" data-reveal>
      <h2>About this item</h2>
      <p>{work.aboutItem ?? work.excerpt}</p>
      {work.maker && <p class="maker">This piece was made by {work.maker}.</p>}
      {work.showFullDescriptionLabel && (
        <a class="show-description" href="#full-description">
          {work.showFullDescriptionLabel}
        </a>
      )}
    </section>

    <section class="detail-block" data-reveal>
      <h2>{work.shippingPolicyTitle ?? "Shipping and return policies"}</h2>
      {work.shippingEstimate && <p>{work.shippingEstimate}</p>}
      {work.shippingCost && <p>Cost to ship: {work.shippingCost}</p>}
      {work.shipsFrom && <p>Ships from: {work.shipsFrom}</p>}
    </section>

    <section id="full-description" class="copy" data-reveal>
      <Content />
    </section>

    {
      work.galleryImages.length > 0 && (
        <section class="gallery" data-reveal>
          <h2>Details</h2>
          <div class="gallery-grid">
            {work.galleryImages.map((image) => <Image src={image} alt={`${work.title} detail`} loading="lazy" />)}
          </div>
        </section>
      )
    }
  </PageContainer>
</SiteLayout>

<style>
  .work-page {
    padding-top: var(--space-7);
    display: grid;
    gap: var(--space-6);
  }

  .back-link {
    justify-self: start;
    color: var(--color-accent-soft);
    font-weight: 600;
  }

  .hero-media {
    overflow: clip;
  }

  .cover {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .header {
    display: grid;
    gap: var(--space-3);
    max-width: 72ch;
  }

  .header h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
  }

  .price {
    color: var(--color-accent-soft);
    font-size: clamp(1.45rem, 4vw, 2rem);
    font-weight: 600;
    margin-top: 0.2rem;
  }

  .excerpt {
    color: var(--color-text-muted);
    max-width: 56ch;
  }

  .detail-block {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    max-width: 56rem;
    background: rgba(255, 255, 255, 0.02);
    display: grid;
    gap: var(--space-2);
  }

  .detail-block h2 {
    font-size: clamp(1.3rem, 3.6vw, 1.9rem);
  }

  .detail-block p,
  .detail-block li {
    color: var(--color-text-muted);
  }

  .detail-block ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.3rem;
  }

  .maker {
    color: var(--color-text);
  }

  .show-description {
    margin-top: var(--space-2);
    color: var(--color-accent-soft);
    font-weight: 600;
    justify-self: start;
  }

  .copy {
    max-width: 68ch;
    color: var(--color-text-muted);
  }

  .gallery {
    display: grid;
    gap: var(--space-4);
  }

  .gallery h2 {
    font-size: clamp(1.6rem, 5vw, 2.4rem);
  }

  .gallery-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .gallery-grid :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }
</style>
