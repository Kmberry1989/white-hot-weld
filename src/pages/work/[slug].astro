---
import { Image } from "astro:assets";
import BuyButton from "../../components/ui/BuyButton.astro";
import SiteLayout from "../../components/layout/SiteLayout.astro";
import PageContainer from "../../components/layout/PageContainer.astro";
import { getAllWork } from "../../lib/content";
import type { WorkItem } from "../../types/content";

export async function getStaticPaths() {
  const work = await getAllWork();

  return work.map((item) => ({
    params: { slug: item.slug },
    props: { work: item }
  }));
}

const { work } = Astro.props as { work: WorkItem };
const { Content } = await work.entry.render();

const medium = work.medium ?? work.materials;
const storeImages = work.storeImages ?? [];
const hasStoreGallery = storeImages.length > 0;
const galleryIntervalMs = 4200;
const aboutText = work.aboutItem ?? work.excerpt;
const statusLabel =
  work.status === "sold" ? "Sold" : work.status === "commissioned" ? "Commissioned" : work.status === "available" ? "Available" : undefined;
const inquiryHref = `/contact?item=${encodeURIComponent(work.slug)}`;
const hasStripeTestCheckout = work.status === "available" && Boolean(work.stripePaymentLink);
const shippingCopy = work.shippingWindow ?? work.shippingEstimate;
const makerMentionedInAbout = (() => {
  if (!work.maker) {
    return false;
  }

  const escapedMaker = work.maker.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const makerPattern = new RegExp(`\\bmade\\s+by\\s+${escapedMaker}\\b`, "i");
  return makerPattern.test(aboutText);
})();
---

<SiteLayout title={work.title} description={work.excerpt} effectPreset="work">
  {work.model3dSrc && <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>}

  <PageContainer size="wide" className="work-page">
    <a class="back-link" href="/gallery" data-reveal>← Back to shop</a>

    <div class="hero-media surface" data-reveal>
      {
        work.model3dSrc ? (
          <>
            <model-viewer
              src={encodeURI(work.model3dSrc)}
              alt={`${work.title} 3D model`}
              class="viewer"
              camera-controls
              auto-rotate
              rotation-per-second="8deg"
              shadow-intensity="0.9"
              exposure="1.1"
            />
            <p class="viewer-hint">Drag to rotate. Scroll to zoom.</p>
          </>
        ) : (
          <Image
            src={work.coverImage}
            alt={`${work.title} main view`}
            loading="eager"
            fetchpriority="high"
            width={1600}
            height={1000}
            class="cover"
          />
        )
      }
    </div>

    <header class="header" data-reveal>
      <h1>{work.title}</h1>
      {statusLabel && <p class={`status ${work.status === "available" ? "status-available" : "status-inactive"}`}>{statusLabel}</p>}
      {work.price && <p class="price">{work.price}</p>}
      <p class="excerpt">{work.excerpt}</p>
      <div class="actions">
        {
          hasStripeTestCheckout && work.price && (
            <BuyButton
              mode="stripe"
              name={work.title}
              price={work.price}
              stripeLink={work.stripePaymentLink}
              label="Buy in Stripe test mode"
              className="shop-button"
            />
          )
        }
        <a class="primary" href={inquiryHref}>
          {work.status === "available" ? "Inquire about this piece" : "Ask about a similar commission"}
        </a>
        <a class="secondary" href="/gallery">Browse available work</a>
      </div>
      {hasStripeTestCheckout && <p class="test-note">Stripe test mode is enabled for this piece. Use test card details only.</p>}
    </header>

    <section class="detail-block" data-reveal>
      <h2>Materials</h2>
      <p>Medium: {medium}</p>
    </section>

    <section class="detail-block" data-reveal>
      <h2>Dimensions</h2>
      <ul>
        {work.widthInches && <li>Width: {work.widthInches} inches</li>}
        {work.heightInches && <li>Height: {work.heightInches} inches</li>}
        {work.depthInches && <li>Depth: {work.depthInches} inches</li>}
      </ul>
    </section>

    <section class="detail-block" data-reveal>
      <h2>About this item</h2>
      <p>{aboutText}</p>
      {work.maker && !makerMentionedInAbout && <p class="maker">This piece was made by {work.maker}.</p>}
      {work.showFullDescriptionLabel && (
        <a class="show-description" href="#full-description">
          {work.showFullDescriptionLabel}
        </a>
      )}
    </section>

    <section class="detail-block" data-reveal>
      <h2>{work.shippingPolicyTitle ?? "Shipping and return policies"}</h2>
      {shippingCopy && <p>{shippingCopy}</p>}
      {work.shippingCost && <p>Cost to ship: {work.shippingCost}</p>}
      {work.shipsFrom && <p>Ships from: {work.shipsFrom}</p>}
    </section>

    <section id="full-description" class="copy" data-reveal>
      <Content />
    </section>

    {
      hasStoreGallery ? (
        <section class="gallery" data-reveal>
          <h2>Details</h2>
          <div class="gallery-showcase" data-gallery-showcase data-gallery-interval-ms={galleryIntervalMs}>
            <div class="gallery-stage">
              {
                storeImages.map((image, index) => (
                  <figure class="gallery-slide" data-gallery-slide data-active={index === 0 ? "true" : "false"}>
                    <img src={encodeURI(image)} alt={`${work.title} detail view ${index + 1}`} loading={index === 0 ? "eager" : "lazy"} />
                  </figure>
                ))
              }
            </div>
            <div class="gallery-thumbs" role="tablist" aria-label={`${work.title} image gallery`}>
              {
                storeImages.map((image, index) => (
                  <button
                    type="button"
                    class="gallery-thumb"
                    data-gallery-thumb
                    data-gallery-index={index}
                    data-active={index === 0 ? "true" : "false"}
                    aria-label={`Show ${work.title} image ${index + 1}`}
                  >
                    <img src={encodeURI(image)} alt="" loading="lazy" />
                  </button>
                ))
              }
            </div>
          </div>
        </section>
      ) : (
        work.galleryImages.length > 0 && (
          <section class="gallery" data-reveal>
            <h2>Details</h2>
            <div class="gallery-grid">
              {work.galleryImages.map((image) => <Image src={image} alt={`${work.title} detail`} loading="lazy" />)}
            </div>
          </section>
        )
      )
    }
  </PageContainer>
  {
    hasStoreGallery && (
      <script>
        (() => {
          const initShowcases = () => {
            document.querySelectorAll("[data-gallery-showcase]").forEach((showcase) => {
              if (showcase.dataset.bound === "true") {
                return;
              }

              const slides = Array.from(showcase.querySelectorAll("[data-gallery-slide]"));
              const thumbs = Array.from(showcase.querySelectorAll("[data-gallery-thumb]"));

              if (slides.length === 0) {
                showcase.dataset.bound = "true";
                return;
              }

              const intervalMs = Number(showcase.getAttribute("data-gallery-interval-ms")) || 4200;
              let currentIndex = 0;

              const setActive = (nextIndex) => {
                currentIndex = nextIndex;

                slides.forEach((slide, slideIndex) => {
                  slide.setAttribute("data-active", slideIndex === currentIndex ? "true" : "false");
                });

                thumbs.forEach((thumb, thumbIndex) => {
                  const active = thumbIndex === currentIndex;
                  thumb.setAttribute("data-active", active ? "true" : "false");
                  thumb.setAttribute("aria-current", active ? "true" : "false");
                });
              };

              const advance = () => {
                setActive((currentIndex + 1) % slides.length);
              };

              let timerId = slides.length > 1 ? window.setInterval(advance, intervalMs) : undefined;

              const stop = () => {
                if (timerId !== undefined) {
                  window.clearInterval(timerId);
                  timerId = undefined;
                }
              };

              const start = () => {
                if (slides.length < 2 || timerId !== undefined) {
                  return;
                }

                timerId = window.setInterval(advance, intervalMs);
              };

              const restart = () => {
                stop();
                start();
              };

              thumbs.forEach((thumb) => {
                thumb.addEventListener("click", () => {
                  const nextIndex = Number(thumb.getAttribute("data-gallery-index"));

                  if (Number.isNaN(nextIndex)) {
                    return;
                  }

                  setActive(nextIndex);
                  restart();
                });
              });

              showcase.addEventListener("mouseenter", stop);
              showcase.addEventListener("mouseleave", start);
              showcase.addEventListener("focusin", stop);
              showcase.addEventListener("focusout", start);
              showcase.dataset.bound = "true";
            });
          };

          if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initShowcases, { once: true });
          } else {
            initShowcases();
          }

          document.addEventListener("astro:after-swap", initShowcases);
        })();
      </script>
    )
  }
</SiteLayout>

<style>
  .work-page {
    padding-top: var(--space-7);
    display: grid;
    gap: var(--space-6);
  }

  .back-link {
    justify-self: start;
    color: var(--color-accent-soft);
    font-weight: 600;
  }

  .hero-media {
    overflow: clip;
  }

  .cover {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }

  .viewer {
    width: 100%;
    aspect-ratio: 16 / 10;
    background:
      radial-gradient(circle at 18% 20%, rgba(224, 101, 47, 0.25), transparent 48%),
      radial-gradient(circle at 82% 12%, rgba(255, 255, 255, 0.08), transparent 46%),
      linear-gradient(160deg, rgba(255, 255, 255, 0.08), rgba(7, 11, 16, 0.85));
  }

  .viewer-hint {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.9rem;
    border-top: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.03);
  }

  .header {
    display: grid;
    gap: var(--space-3);
    max-width: 72ch;
  }

  .header h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
  }

  .price {
    color: var(--color-accent-soft);
    font-size: clamp(1.45rem, 4vw, 2rem);
    font-weight: 600;
    margin-top: 0.2rem;
  }

  .shop-button {
    order: -1;
  }

  .test-note {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .status {
    justify-self: start;
    margin: 0;
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .status-available {
    color: #ffd9c7;
    background: rgba(224, 101, 47, 0.18);
    border: 1px solid rgba(224, 101, 47, 0.34);
  }

  .status-inactive {
    color: rgba(228, 235, 241, 0.88);
    background: rgba(120, 140, 158, 0.14);
    border: 1px solid rgba(120, 140, 158, 0.28);
  }

  .excerpt {
    color: var(--color-text-muted);
    max-width: 56ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .primary,
  .secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.72rem 1rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .primary {
    background: var(--color-accent);
    color: #111317;
  }

  .secondary {
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .detail-block {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    max-width: 56rem;
    background: rgba(255, 255, 255, 0.02);
    display: grid;
    gap: var(--space-2);
  }

  .detail-block h2 {
    font-size: clamp(1.3rem, 3.6vw, 1.9rem);
  }

  .detail-block p,
  .detail-block li {
    color: var(--color-text-muted);
  }

  .detail-block ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.3rem;
  }

  .maker {
    color: var(--color-text);
  }

  .show-description {
    margin-top: var(--space-2);
    color: var(--color-accent-soft);
    font-weight: 600;
    justify-self: start;
  }

  .copy {
    max-width: 68ch;
    color: var(--color-text-muted);
  }

  .gallery {
    display: grid;
    gap: var(--space-4);
  }

  .gallery h2 {
    font-size: clamp(1.6rem, 5vw, 2.4rem);
  }

  .gallery-showcase {
    display: grid;
    gap: var(--space-3);
  }

  .gallery-stage {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: clip;
    border: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.02);
  }

  .gallery-slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 680ms ease;
  }

  .gallery-slide[data-active="true"] {
    opacity: 1;
  }

  .gallery-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery-thumbs {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(auto-fit, minmax(4.8rem, 1fr));
  }

  .gallery-thumb {
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius-md) * 0.7);
    overflow: clip;
    background: transparent;
    cursor: pointer;
    opacity: 0.75;
    transition:
      opacity 200ms ease,
      border-color 200ms ease,
      transform 200ms ease;
  }

  .gallery-thumb img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }

  .gallery-thumb:hover,
  .gallery-thumb[data-active="true"] {
    opacity: 1;
    border-color: rgba(224, 101, 47, 0.7);
    transform: translateY(-2px);
  }

  .gallery-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .gallery-grid :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }
</style>
