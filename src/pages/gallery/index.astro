---
import SiteLayout from "../../components/layout/SiteLayout.astro";
import Section from "../../components/ui/Section.astro";
import WorkCard from "../../components/ui/WorkCard.astro";
import { getAllWork, getPageContent } from "../../lib/content";

const page = await getPageContent("gallery");
const work = await getAllWork();
const hasModelPreview = work.some((item) => Boolean(item.model3dSrc));
const { Content } = await page.render();
---

<SiteLayout
  title={page.data.title}
  description={page.data.description}
  seoTitle={page.data.seoTitle}
  seoDescription={page.data.seoDescription}
  effectPreset="gallery"
>
  {hasModelPreview && <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>}

  <Section id="gallery" kicker={page.data.eyebrow} title={page.data.title} lede={page.data.description}>
    <div class="prose" data-reveal>
      <Content />
    </div>

    <div class="grid">
      {
        work.map((item, index) => (
          <WorkCard item={item} priority={index === 0} showModelPreview />
        ))
      }
    </div>
  </Section>
</SiteLayout>

<style>
  .prose {
    max-width: 64ch;
    color: var(--color-text-muted);
  }

  .grid {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  @media (min-width: 52rem) {
    .grid {
      grid-template-columns: minmax(0, min(92vw, 52rem));
    }
  }
</style>
