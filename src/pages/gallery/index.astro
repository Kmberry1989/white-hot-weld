---
import BuyButton from "../../components/ui/BuyButton.astro";
import SiteLayout from "../../components/layout/SiteLayout.astro";
import Section from "../../components/ui/Section.astro";
import WorkCard from "../../components/ui/WorkCard.astro";
import { getAllWork, getPageContent } from "../../lib/content";

const page = await getPageContent("gallery");
const work = await getAllWork();
const hasModelPreview = work.some((item) => Boolean(item.model3dSrc));
const featuredAvailableWork = work.find((item) => item.status === "available") ?? work[0];
const sectionKicker =
  page.data.eyebrow && page.data.eyebrow.trim().toLowerCase() !== page.data.title.trim().toLowerCase()
    ? page.data.eyebrow
    : undefined;
const { Content } = await page.render();
---

<SiteLayout
  title={page.data.title}
  description={page.data.description}
  seoTitle={page.data.seoTitle}
  seoDescription={page.data.seoDescription}
  effectPreset="gallery"
>
  {hasModelPreview && <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>}

  <Section id="gallery" kicker={sectionKicker} title={page.data.title} lede={page.data.description}>
    <div class="prose" data-reveal>
      <Content />
    </div>

    <div class="actions" data-reveal>
      {featuredAvailableWork && <a class="primary" href={`/work/${featuredAvailableWork.slug}`}>View available piece</a>}
      {
        featuredAvailableWork?.stripePaymentLink && featuredAvailableWork.price && (
          <BuyButton
            mode="stripe"
            name={featuredAvailableWork.title}
            price={featuredAvailableWork.price}
            stripeLink={featuredAvailableWork.stripePaymentLink}
            label="Stripe test checkout"
          />
        )
      }
      <a class="secondary" href="/contact">Commission custom work</a>
      <a class="secondary" href="/gallery/lowres">View image gallery</a>
    </div>

    <div class="grid">
      {
        work.map((item, index) => (
          <WorkCard item={item} priority={index === 0} showModelPreview />
        ))
      }
    </div>
  </Section>
</SiteLayout>

<style>
  .prose {
    max-width: 64ch;
    color: var(--color-text-muted);
  }

  .grid {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .primary,
  .secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.72rem 1rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .primary {
    background: var(--color-accent);
    color: #0f1113;
  }

  .secondary {
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  @media (min-width: 52rem) {
    .grid {
      grid-template-columns: minmax(0, min(96vw, 76rem));
    }
  }
</style>
